kubectl scale statefulset seed-old-manticoresearch-worker --replicas=0; timeout 420 bash -c 'until ! kubectl get pod seed-old-manticoresearch-worker-0 >/dev/null 2>&1 && ! kubectl get pod seed-old-manticoresearch-worker-1 >/dev/null 2>&1; do sleep 2; done'; echo "old_workers_scaled_down=0"
––– output –––
statefulset.apps/seed-old-manticoresearch-worker scaled
old_workers_scaled_down=0
––– input –––
helm uninstall seed-old >/dev/null 2>&1; echo "old_release_uninstalled_pvcs_retained=$(kubectl get pvc data-seed-old-manticoresearch-worker-0 data-seed-old-manticoresearch-worker-1 --no-headers 2>/dev/null | wc -l | tr -d ' ')"
––– output –––
old_release_uninstalled_pvcs_retained=2
––– input –––
cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: data-seed-new-manticoresearch-worker-0
  labels:
    mre: manticore-seed-restore
    app.kubernetes.io/component: worker
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi
EOF
echo "new_seed_pvc_created=1"
––– output –––
persistentvolumeclaim/data-seed-new-manticoresearch-worker-0 created
new_seed_pvc_created=1
––– input –––
cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: seed-copy-0
  labels:
    mre: manticore-seed-restore
spec:
  restartPolicy: Never
  containers:
    - name: copy
      image: busybox:1.36
      command: ["sh", "-c", "cp -a /old/. /new/ && echo copied-0"]
      volumeMounts:
        - name: old-data
          mountPath: /old
          readOnly: true
        - name: new-data
          mountPath: /new
  volumes:
    - name: old-data
      persistentVolumeClaim:
        claimName: data-seed-old-manticoresearch-worker-0
    - name: new-data
      persistentVolumeClaim:
        claimName: data-seed-new-manticoresearch-worker-0
EOF
timeout 300 bash -c 'until kubectl get pod seed-copy-0 2>/dev/null | grep -q "seed-copy-0[[:space:]]*0/1[[:space:]]*Completed"; do sleep 2; done'; echo "snapshot_data_copied=worker0_only"
––– output –––
pod/seed-copy-0 created
snapshot_data_copied=worker0_only
––– input –––
cat <<EOF | kubectl apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: seed-inspect-0
  labels:
    mre: manticore-seed-restore
spec:
  restartPolicy: Never
  containers:
    - name: inspect
      image: busybox:1.36
      command: ["sh", "-c", "echo nodes:; grep -o 'seed-old-manticoresearch-worker-[01][^,:\" ]*' /data/manticore.json | sort -u; echo grastate:; grep -E 'seqno|safe_to_bootstrap' /data/manticore/replication/manticore_cluster/grastate.dat 2>/dev/null || true"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: data-seed-new-manticoresearch-worker-0
EOF
timeout 120 bash -c 'until kubectl get pod seed-inspect-0 2>/dev/null | grep -q "seed-inspect-0[[:space:]]*0/1[[:space:]]*Completed"; do sleep 2; done'; kubectl logs seed-inspect-0
