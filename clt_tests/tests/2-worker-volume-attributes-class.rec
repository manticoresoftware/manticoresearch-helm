helm template default ./charts/manticoresearch >/tmp/volume-attributes-class-default.yaml; if grep -Fq 'volumeAttributesClassName:' /tmp/volume-attributes-class-default.yaml; then cat /tmp/volume-attributes-class-default.yaml; false; else echo "default omits volume attributes class"; fi
