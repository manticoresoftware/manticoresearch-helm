––– comment –––
Verify that a worker-data backup can be restored into a different Helm release or namespace even when its persisted cluster state still contains the source workers' DNS names.
––– block: ./init/init –––
––– input –––
for release in seed-old seed-new; do helm uninstall "$release" >/dev/null 2>&1 || true; done; kubectl delete pod seed-copy-0 seed-inspect-0 --wait=false >/dev/null 2>&1 || true; kubectl delete pvc -l mre=manticore-seed-restore --wait=false >/dev/null 2>&1 || true; kubectl delete pvc -l app.kubernetes.io/component=worker --wait=false >/dev/null 2>&1 || true; echo "cleanup complete"
––– output –––
cleanup complete
––– input –––
printf 'balancer:\n  enabled: false\nworker:\n  replicaCount: 2\n  persistence:\n    size: 10Gi\n  image:\n    tag: 0.0.0-unstable\n' >/tmp/seed-old-values.yaml; printf 'balancer:\n  enabled: false\nworker:\n  replicaCount: 1\n  persistence:\n    size: 10Gi\n  image:\n    tag: 0.0.0-unstable\n' >/tmp/seed-new-values.yaml; echo "values_written=old2_new1"
––– output –––
values_written=old2_new1
––– input –––
helm install seed-old -f /tmp/seed-old-values.yaml ./charts/manticoresearch >/tmp/seed-old-install.log 2>&1 && echo "release=seed-old status=deployed"
––– output –––
release=seed-old status=deployed
––– input –––
if timeout 420 bash -c 'until kubectl get pod seed-old-manticoresearch-worker-0 seed-old-manticoresearch-worker-1 2>/dev/null | grep -q "seed-old-manticoresearch-worker-0[[:space:]]*1/1[[:space:]]*Running" && kubectl get pod seed-old-manticoresearch-worker-0 seed-old-manticoresearch-worker-1 2>/dev/null | grep -q "seed-old-manticoresearch-worker-1[[:space:]]*1/1[[:space:]]*Running"; do sleep 2; done'; then echo "old_workers_ready=2"; else echo "old_workers_wait_failed"; kubectl get pod -o wide; false; fi
––– output –––
old_workers_ready=2
––– input –––
kubectl exec seed-old-manticoresearch-worker-0 -- mysql -h0 -P9306 -e "CREATE TABLE idx(title text)"; kubectl exec seed-old-manticoresearch-worker-0 -- mysql -h0 -P9306 -e "ALTER CLUSTER manticore_cluster ADD idx"; kubectl exec seed-old-manticoresearch-worker-0 -- mysql -h0 -P9306 -e "INSERT INTO manticore_cluster:idx (title) VALUES ('seed restore mre')"; echo "old_cluster_seeded=$?"
––– output –––
old_cluster_seeded=0
––– input –––
timeout 300 bash -c 'for pod in seed-old-manticoresearch-worker-0 seed-old-manticoresearch-worker-1; do until kubectl exec "$pod" -- mysql -h0 -P9306 -e "SHOW TABLES; SELECT COUNT(*) FROM idx; show status like '\''cluster_%_node_state'\'';" 2>/dev/null | grep -q synced; do sleep 2; done; done'; for pod in seed-old-manticoresearch-worker-0 seed-old-manticoresearch-worker-1; do out=$(kubectl exec "$pod" -- mysql -h0 -P9306 -e "show status like 'cluster_%_node_state'; show status like 'cluster_%_status'; show status like 'cluster_%_size'; SELECT COUNT(*) FROM idx;" 2>/dev/null); state=$(echo "$out" | grep "cluster_manticore_cluster_node_state" | grep -o "synced"); status=$(echo "$out" | grep "cluster_manticore_cluster_status" | grep -o "primary"); size=$(echo "$out" | grep "cluster_manticore_cluster_size" | grep -o "2" | head -n1); count=$(echo "$out" | tr -dc "0-9" | tail -c 1); echo "$pod state=$state status=$status size=$size rows=$count"; done
––– output –––
seed-old-manticoresearch-worker-0 state=synced status=primary size=2 rows=1
seed-old-manticoresearch-worker-1 state=synced status=primary size=2 rows=1
––– input –––
for pod in seed-old-manticoresearch-worker-0 seed-old-manticoresearch-worker-1; do echo "--- $pod grastate ---"; kubectl exec "$pod" -- sh -lc "grep -E 'seqno|safe_to_bootstrap' /var/lib/manticore/manticore/replication/manticore_cluster/grastate.dat 2>/dev/null || true"; done
––– output –––
--- seed-old-manticoresearch-worker-0 grastate ---
--- seed-old-manticoresearch-worker-1 grastate ---
