printf 'balancer:\n  enabled: false\nworker:\n  replicaCount: 2\n  persistence:\n    size: 1Gi\n  image:\n    tag: 0.0.0-unstable\n' >/tmp/clt-values.yaml; cat /tmp/clt-values.yaml
