––– block: ./init/cleanup-release –––
––– input –––
if helm template bad ./charts/manticoresearch --set-string 'worker.searchd.extraArgs[0]=; echo unsafe' >/tmp/searchd-extra-args-invalid.yaml 2>/tmp/searchd-extra-args-invalid.err; then cat /tmp/searchd-extra-args-invalid.yaml; false; else grep -q 'Invalid worker.searchd.extraArgs value' /tmp/searchd-extra-args-invalid.err && echo "invalid extra arg rejected"; fi
––– output –––
invalid extra arg rejected
––– input –––
printf 'balancer:\n  enabled: false\nworker:\n  replicaCount: 1\n  searchd:\n    extraArgs:\n      - --logdebug\n  image:\n    tag: 0.0.0-unstable\n' >/tmp/clt-values.yaml; cat /tmp/clt-values.yaml
––– output –––
balancer:
  enabled: false
worker:
  replicaCount: 1
  searchd:
    extraArgs:
      - --logdebug
  image:
    tag: 0.0.0-unstable
––– block: ./init/install –––
––– input –––
if kubectl wait --for=condition=Ready pod/my-helm-manticoresearch-worker-0 --timeout=300s >/dev/null; then echo "OK"; else echo "Failed waiting until worker pod was ready"; kubectl get po -o wide || true; kubectl describe pod my-helm-manticoresearch-worker-0 || true; kubectl logs my-helm-manticoresearch-worker-0 --all-containers=true --tail=200 || true; false; fi
––– output –––
OK
––– input –––
if timeout 120 bash -c 'until kubectl exec my-helm-manticoresearch-worker-0 -- sh -c "ps -eo args | grep '\''searchd .*--logdebug'\'' | grep -v grep >/dev/null"; do sleep 2; done'; then echo "searchd got --logdebug"; else echo "searchd --logdebug was not found"; kubectl get po -o wide || true; kubectl describe pod my-helm-manticoresearch-worker-0 || true; kubectl logs my-helm-manticoresearch-worker-0 --all-containers=true --tail=200 || true; kubectl exec my-helm-manticoresearch-worker-0 -- sh -c 'echo "--- env ---"; printenv | sort | grep -E "SEARCHD|MANTICORE|CONFIGMAP|CLUSTER|WORKER|BALANCER|LOG" || true; echo "--- ps ---"; ps -eo pid,ppid,args || true; echo "--- supervisord ---"; grep -n "command = searchd" /etc/supervisord.conf || true; supervisorctl status || true; cat /tmp/supervisord.log || true' || true; false; fi
––– output –––
searchd got --logdebug
––– input –––
if timeout 120 bash -c 'until kubectl exec my-helm-manticoresearch-worker-0 -- mysql -h0 -P9306 -e "SELECT 1" >/dev/null 2>&1; do sleep 2; done' && timeout 120 bash -c 'until kubectl logs my-helm-manticoresearch-worker-0 2>/dev/null | grep -qi debug; do sleep 2; done'; then echo "debug logs found"; else echo "debug logs were not found"; kubectl get po -o wide || true; kubectl describe pod my-helm-manticoresearch-worker-0 || true; kubectl logs my-helm-manticoresearch-worker-0 --all-containers=true --tail=300 || true; kubectl exec my-helm-manticoresearch-worker-0 -- sh -c 'echo "--- ps ---"; ps -eo pid,ppid,args || true; echo "--- mysql status ---"; mysql -h0 -P9306 -e "SELECT 1" || true; echo "--- supervisor ---"; supervisorctl status || true' || true; false; fi
